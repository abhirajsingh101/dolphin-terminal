#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

for executable in python npm; do
  if ! command -v "$executable" >/dev/null 2>&1; then
    echo "Missing required local executable: $executable" >&2
    echo "Use the Docker quick start if you do not want host-side dependencies." >&2
    exit 2
  fi
done

cd "$project_root"
python -m venv .venv
.venv/bin/python -m pip install --upgrade pip
npm ci --no-audit
npm run build
.venv/bin/pip install -e './python[dev]'

echo "Dolphin Terminal is installed locally."
echo "Run: $project_root/.venv/bin/dolphin-terminal serve /path/to/workspace"
