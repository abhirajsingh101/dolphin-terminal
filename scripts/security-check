#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"

for required_tool in npm node python uvx gitleaks rg; do
  if ! command -v "$required_tool" >/dev/null 2>&1; then
    echo "security-check requires $required_tool." >&2
    exit 1
  fi
done

npm audit --offline --audit-level=high
node scripts/generate-third-party-licenses.mjs --check
python scripts/license-check.py
uvx pip-audit python --progress-spinner off
uvx bandit -r python/dolphin_terminal -q --severity-level medium
gitleaks dir . --no-banner --redact --exit-code 1

private_user="${DOLPHIN_TERMINAL_PRIVATE_USER:-$(python -c 'import os, pwd; print(pwd.getpwuid(os.getuid()).pw_name)')}"
private_markers=("/home/$private_user" "/data/$private_user" "$private_user@")
if [[ -n "${DOLPHIN_TERMINAL_PRIVATE_IP:-}" ]]; then
  private_markers+=("$DOLPHIN_TERMINAL_PRIVATE_IP")
fi
marker_args=()
for marker in "${private_markers[@]}"; do
  marker_args+=(-e "$marker")
done

if rg -F -n "${marker_args[@]}" \
  --glob '!node_modules/**' \
  --glob '!python/dolphin_terminal/static/**' \
  --glob '!test-results/**' \
  --glob '!*.tsbuildinfo' \
  .; then
  echo 'Personal-path scan found release-blocking content.' >&2
  exit 1
fi

echo 'SECURITY_CHECK=PASS'
