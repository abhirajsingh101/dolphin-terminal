# One path, several colon-separated paths, id=/path entries, or a JSON list.
DOLPHIN_TERMINAL_WORKSPACES=alpha=/home/user/projects/alpha

# Same-origin production UI plus the development Vite origin. No wildcards.
DOLPHIN_TERMINAL_ALLOWED_ORIGINS=http://127.0.0.1:8733,http://localhost:8733,http://127.0.0.1:8734,http://localhost:8734
DOLPHIN_TERMINAL_HOST=127.0.0.1
DOLPHIN_TERMINAL_PORT=8733
# Self-contained default. Set this to tmux only to attach existing tmux sessions.
DOLPHIN_TERMINAL_SESSION_BACKEND=native

# Optional trusted host configuration. Never accepted from the browser.
# DOLPHIN_TERMINAL_SHELL=/bin/bash
# DOLPHIN_TERMINAL_NATIVE_RUNTIME_DIR=/run/user/1000/dolphin-terminal
# DOLPHIN_TERMINAL_NATIVE_STATE_DIR=/home/user/.local/state/dolphin-terminal

# Optional local speech recognition provider. Both settings are required.
DOLPHIN_TERMINAL_ENABLE_DICTATION=0
DOLPHIN_TERMINAL_ASR_URL=http://127.0.0.1:8411
# DOLPHIN_TERMINAL_ASR_MAX_AUDIO_BYTES=16777216
# DOLPHIN_TERMINAL_STATIC_DIR=/path/to/compiled/ui
